{
  "name": "@kaaryasthan/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env.local --watch --import tsx src/server.ts",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --filter @kaaryasthan/shared build && vitest run",
    "build": "tsc --noEmit",
    "migrate:auth-indexes": "node --env-file=.env.local --import tsx scripts/migrate-auth-indexes.ts"
  },
  "dependencies": {
    "@kaaryasthan/shared": "workspace:*",
    "@node-rs/argon2": "2.2.2",
    "@upstash/ratelimit": "^2.2.2",
    "@upstash/redis": "^1.41.1",
    "cookie": "2.0.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jose": "6.2.18",
    "mongoose": "^9.13.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kaaryasthan/config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^22.15.30",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.1",
    "mongodb-memory-server": "11.4.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
